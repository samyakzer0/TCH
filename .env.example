# =============================================================================
# The Chai House - Environment Configuration
# =============================================================================

# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional: Service role key for administrative operations (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Configuration
ADMIN_EMAIL=admin@thechai.house
ADMIN_PASSWORD=admin123
NEXT_PUBLIC_ADMIN_EMAIL=admin@thechai.house

# Local SQLite Fallback (used automatically if Supabase is not configured)
DATABASE_PATH=./data/tch.db

# General Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CLOSING_TIME=22:00
OPENING_TIME=08:00

# Email Configuration (Optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google Sheets Configuration (Optional - for order backup)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
